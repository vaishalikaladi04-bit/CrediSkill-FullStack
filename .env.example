# Generate a unique value, for example with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-unique-random-secret

# Local MongoDB example; use your own MongoDB Atlas URI for a hosted database.
MONGO_URI=mongodb://localhost:27017/smart_education

# Optional: enables AI-generated assessments and related features.
GROQ_API_KEY=

# Required only when creating the initial administrator with create_admin.py.
ADMIN_EMAIL=
ADMIN_PASSWORD=
